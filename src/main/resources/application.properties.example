spring.application.name=exam-platform
server.port=8080

# ============ 数据源 ============
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://localhost:3306/pingce?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:change_me}

# ============ MyBatis-Plus ============
mybatis-plus.mapper-locations=classpath*:/mapper/**/*.xml
mybatis-plus.type-aliases-package=com.exam.entity
# 下划线自动转驼峰
mybatis-plus.configuration.map-underscore-to-camel-case=true
# 开发环境打印 SQL
mybatis-plus.configuration.log-impl=org.apache.ibatis.logging.stdout.StdOutImpl
# 主键自增
mybatis-plus.global-config.db-config.id-type=auto

# ============ JWT ============
# secret 长度必须 >= 32 字节（HS256 要求），生产环境请务必修改
jwt.secret=${JWT_SECRET:change_me_in_production}
# token 有效期（秒），默认 24 小时
jwt.expiration=86400
jwt.header=Authorization
jwt.token-prefix=Bearer

# ============ Knife4j / springdoc ============
knife4j.enable=true
springdoc.api-docs.enabled=true
springdoc.swagger-ui.enabled=true
springdoc.swagger-ui.path=/swagger-ui.html
